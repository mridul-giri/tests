generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id   Int         @id @default(autoincrement())
  type RequestType
  a    Int
  b    Int
  ans  Int
}

enum RequestType {
  Sum
  Multiply
}
